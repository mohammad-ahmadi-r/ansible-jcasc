[Unit]
Description=Jenkins Continuous Integration Server
Requires=network.target
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=5m

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/jenkins
Restart=on-failure
SuccessExitStatus=143

User=jenkins
Group=jenkins

Environment="JENKINS_HOME=/var/lib/jenkins"
WorkingDirectory=/var/lib/jenkins

Environment="JENKINS_WEBROOT=%C/jenkins/war"

Environment="JAVA_OPTS=-Djava.awt.headless=true -Djenkins.install.runSetupWizard=false"
Environment="CASC_JENKINS_CONFIG=/var/lib/jenkins/casc_configs/casc.yaml"

Environment="JENKINS_PORT=8081"
Environment="GITHUB_TOKEN=gituhb-personal-access-token"
Environment="JENKINS_ADMIN=mamad"
Environment="JENKINS_ADMIN_PASSWORD=123456"
Environment="GITHUB_CREDS=github-https-creds"
Environment="GITHUB_USER=github-username"
Environment="AUTH_TOKEN=456321"

[Install]
WantedBy=multi-user.target

